{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "ScriptHost", "WebWorker"],
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "removeComments": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "incremental": true, // Habilita a compilação incremental para melhorar a performance
    "composite": true, // Necessário para projetos compostos
    "tsBuildInfoFile": "./dist/.tsbuildinfo", // Arquivo de informações de build incremental
    "moduleResolution": "node", // Resolve módulos usando a lógica do Node.js
    "allowSyntheticDefaultImports": true, // Permite importações padrão sintéticas
    "emitDecoratorMetadata": true, // Emite metadados de decoradores
    "experimentalDecorators": true, // Habilita decoradores experimentais
    "baseUrl": ".", // Base URL para resolver módulos
    "paths": { // Alias para caminhos de módulos
        "@src/*": ["src/*"],
        "@components/*": ["src/components/*"],
        "@utils/*": ["src/utils/*"]
    },
    "typeRoots": [
        "./node_modules/@types",
        "./src/types"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
