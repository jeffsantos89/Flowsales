# marketing-automation — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SERVICE_NAME=marketing-automation

# --- Database ---
DATABASE_URL=postgresql://marketing:CHANGEME_DB_PASSWORD@localhost:5432/marketing_automation

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=marketing-automation
KAFKA_GROUP_ID=marketing-automation-consumer

# --- JWT ---
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json

# --- Email (SMTP) ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=CHANGEME_MAILTRAP_USER
MAIL_PASS=CHANGEME_MAILTRAP_PASS
MAIL_FROM=noreply@flowsale.app

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=marketing-automation
PROMETHEUS_PORT=9096
