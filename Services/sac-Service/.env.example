# sac-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.

# --- App ---
NODE_ENV=development
PORT=3011
LOG_LEVEL=debug
SERVICE_NAME=sac-service

# --- Database ---
DATABASE_URL=postgresql://sac:CHANGEME_DB_PASSWORD@localhost:5432/sac_service

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sac-service
KAFKA_GROUP_ID=sac-service-consumer

# --- JWT ---
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=sac-service
PROMETHEUS_PORT=9098
