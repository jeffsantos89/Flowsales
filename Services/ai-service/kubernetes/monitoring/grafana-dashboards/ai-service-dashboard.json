{
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "prometheus",
        "iconColor": "#37872D",
        "enable": true,
        "query": "kube_deployment_status_replicas{namespace=\"default\"}",
        "titleFormat": "Deployment: {{deployment}}",
        "textFormat": "Namespace: {{namespace}}, Replicas: {{replicas}}"
      },
      {
        "name": "Incidents",
        "datasource": "prometheus",
        "iconColor": "#F2495C",
        "enable": true,
        "query": "ALERTS{severity=\"critical\"}",
        "titleFormat": "Alert: {{alertname}}",
        "textFormat": "{{description}}"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "title": "System Overview",
      "type": "row"
    },
    {
      "type": "stat",
      "title": "System Health Score",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "targets": [
        {
          "expr": "avg(up{job=\"ai-service\"})",
          "legendFormat": "Health Score"
        }
      ],
      "thresholds": {
        "steps": [
          { "value": null, "color": "red" },
          { "value": 0.5, "color": "yellow" },
          { "value": 0.8, "color": "green" }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "API Requests per Minute",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[$Interval])) by (method, status)",
          "legendFormat": "{{method}} ({{status}})"
        }
      ],
      "options": {
        "legend": { "show": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Resource Usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[$Interval])) by (pod) * 100",
          "legendFormat": "CPU: {{pod}}"
        },
        {
          "expr": "sum(container_memory_usage_bytes{container!=\"\"}) by (pod) / 1024 / 1024",
          "legendFormat": "Memory: {{pod}} MB"
        }
      ]
    },
    {
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "title": "AI Service Metrics",
      "type": "row"
    },
    {
      "type": "timeseries",
      "title": "AI Model Performance",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {
          "expr": "avg_over_time(ai_service_accuracy[$Interval])",
          "legendFormat": "Accuracy"
        },
        {
          "expr": "avg_over_time(ai_service_latency_seconds[$Interval])",
          "legendFormat": "Latency"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Model Health",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 14},
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "ai_service_model_health",
          "legendFormat": "Health Score"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["ai-service", "production"],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "Datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "type": "interval",
        "name": "Interval",
        "query": "1m,5m,10m,30m,1h",
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        },
        "auto": true,
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "pod",
        "datasource": "$Datasource",
        "query": "label_values(kube_pod_info, pod)",
        "refresh": 2
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "browser",
  "title": "AI Service Dashboard",
  "version": 1,
  "weekStart": ""
}
