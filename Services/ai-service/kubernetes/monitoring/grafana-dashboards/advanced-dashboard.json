{
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "Datasource",
        "label": "Datasource",
        "query": "prometheus",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "type": "interval",
        "name": "Interval",
        "label": "Interval",
        "query": "30s,1m,5m,10m,30m,1h,6h,12h,24h",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "auto": true,
        "auto_count": 30
      },
      {
        "type": "custom",
        "name": "Environment",
        "label": "Environment",
        "query": "prod,staging,dev",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "$Datasource",
        "iconColor": "rgba(255, 96, 96, 1)",
        "enable": true,
        "query": "changes(deployment{environment=\"$Environment\"})",
        "titleFormat": "Deployment: {{deployment}}",
        "textFormat": "Deployment of {{deployment}} version {{version}} at {{time}}"
      },
      {
        "name": "Incidents",
        "datasource": "$Datasource",
        "iconColor": "rgba(255, 0, 0, 1)",
        "enable": true,
        "query": "ALERTS{severity=\"critical\",environment=\"$Environment\"}",
        "titleFormat": "Alert: {{alertname}}",
        "textFormat": "{{description}}"
      }
    ]
  },
  "dashboards": [
    {
      "title": "Performance Dashboard",
      "panels": [
        {
          "type": "graph",
          "title": "API Requests per Minute",
          "datasource": "$Datasource",
          "targets": [
            {
              "expr": "sum(rate(http_requests_total{environment=\"$Environment\"}[$Interval])) by (method, route)",
              "legendFormat": "{{method}} {{route}}"
            }
          ],
          "alert": {
            "name": "High Request Rate",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [1000]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": ["A", "5m", "now"]
                }
              }
            ]
          },
          "yaxes": [
            {
              "format": "rpm",
              "min": 0
            }
          ],
          "thresholds": [
            {
              "value": 800,
              "colorMode": "warning",
              "op": "gt",
              "fill": true,
              "line": true
            }
          ]
        },
        {
          "type": "graph",
          "title": "Response Time Distribution",
          "datasource": "$Datasource",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{environment=\"$Environment\"}[$Interval])) by (le, service))",
              "legendFormat": "p95 - {{service}}"
            },
            {
              "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{environment=\"$Environment\"}[$Interval])) by (le, service))",
              "legendFormat": "p50 - {{service}}"
            }
          ]
        }
      ],
      "refresh": "1m",
      "schemaVersion": 21,
      "version": 1,
      "tags": ["performance", "monitoring"],
      "timezone": "browser"
    },
    {
      "title": "System Health Dashboard",
      "panels": [
        {
          "type": "stat",
          "title": "System Health Score",
          "datasource": "$Datasource",
          "targets": [
            {
              "expr": "avg(up{environment=\"$Environment\"})",
              "legendFormat": "Health Score"
            }
          ],
          "options": {
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto",
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 0.7, "color": "yellow" },
                { "value": 0.9, "color": "green" }
              ]
            }
          }
        },
        {
          "type": "timeseries",
          "title": "Resource Usage",
          "datasource": "$Datasource",
          "targets": [
            {
              "expr": "sum(rate(container_cpu_usage_seconds_total{namespace='ai',environment=\"$Environment\"}[$Interval])) by (container_name)",
              "legendFormat": "CPU - {{container_name}}"
            },
            {
              "expr": "sum(container_memory_usage_bytes{namespace='ai',environment=\"$Environment\"}) by (container_name)",
              "legendFormat": "Memory - {{container_name}}"
            }
          ]
        }
      ],
      "refresh": "1m"
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h"
    ]
  },
  "editable": true,
  "graphTooltip": 1
}
