{
    "name": "ai-service",
    "version": "1.0.0",
    "main": "dist/app.js",
    "scripts": {
        "start": "node dist/app.js",
        "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
        "build": "tsc",
        "test": "jest --coverage",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write .",
        "prepare": "husky install",
        "precommit": "lint-staged"
    },
    "dependencies": {
        "express": "^4.18.2",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "kafkajs": "^1.15.0",
        "pg": "^8.7.1",
        "redis": "^4.2.0",
        "typeorm": "^0.3.10",
        "winston": "^3.17.0",
        "dotenv": "^16.0.0",
        "helmet": "^5.0.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5"
    },
    "devDependencies": {
        "@types/express": "^4.17.13",
        "@types/jest": "^27.4.0",
        "@types/node": "^17.0.45",
        "eslint": "^8.10.0",
        "jest": "^27.4.7",
        "prettier": "^2.5.1",
        "ts-node": "^10.7.0",
        "typescript": "^4.6.3",
        "ts-node-dev": "^1.1.8",
        "husky": "^7.0.4",
        "lint-staged": "^12.3.7"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}