# ai-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.

# --- App ---
PORT=5001
FLASK_ENV=development
LOG_LEVEL=DEBUG
SERVICE_NAME=ai-service

# --- Scoring ---
SCORE_CACHE_TTL_SECONDS=300
SCORE_DEFAULT_FALLBACK=50

# --- OpenAI (opcional — habilita scoring avançado) ---
OPENAI_API_KEY=CHANGEME_GET_FROM_OPENAI_DASHBOARD
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (opcional) ---
ANTHROPIC_API_KEY=CHANGEME_GET_FROM_ANTHROPIC_CONSOLE

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ai-service

# --- Redis (cache de scoring) ---
REDIS_URL=redis://localhost:6379

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-service
