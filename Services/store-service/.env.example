# store-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.

# --- App ---
NODE_ENV=development
PORT=3007
LOG_LEVEL=info
SERVICE_NAME=store-service

# --- Database ---
DB_HOST=localhost
DB_USER=postgres
DB_PASS=CHANGEME_DB_PASSWORD
DB_NAME=flowsale_store
DB_PORT=5432

# --- JWT ---
JWT_SECRET=CHANGEME_JWT_SECRET_64_CHARS
JWT_EXPIRES_IN=1h
