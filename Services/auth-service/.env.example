# auth-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.
# Bootstrap automático: ./scripts/setup-env.sh na raiz do monorepo.

# --- App ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
SERVICE_NAME=auth-service
SERVICE_VERSION=1.0.0

# --- Database ---
DATABASE_URL=postgresql://auth:CHANGEME_DB_PASSWORD@localhost:5432/auth_service

# --- Redis (sessões e rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-service
KAFKA_GROUP_ID=auth-service-consumer

# --- JWT (EdDSA — NÃO usar HS256/RS256 em novo código) ---
# As chaves são geradas automaticamente na primeira inicialização (KeyRotationManager)
# Não definir chave fixa em produção — usar rotação automática
TOKEN_ISSUER=http://localhost:3001
TOKEN_AUDIENCE=flowsale-services
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SIGNING_KEY_ROTATION_DAYS=90

# --- Argon2id (hash de senha) ---
# Valores abaixo são seguros para dev; produção: auto-tune no boot
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
ARGON2_PEPPER=CHANGEME_HEX_64_CHARS_00000000000000000000000000000000000000000000000000000000

# --- TOTP ---
TOTP_ISSUER=Flowsale
TOTP_WINDOW=1

# --- Segurança ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=auth-service
PROMETHEUS_PORT=9091
