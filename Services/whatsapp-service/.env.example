# whatsapp-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.

# --- App ---
NODE_ENV=development
PORT=3008
LOG_LEVEL=debug
SERVICE_NAME=whatsapp-service

# --- WhatsApp Cloud API ---
WHATSAPP_API_URL=https://graph.facebook.com/v12.0
WHATSAPP_API_TOKEN=CHANGEME_GET_FROM_META_DEVELOPER_PORTAL
WHATSAPP_PHONE_NUMBER_ID=CHANGEME_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=CHANGEME_WEBHOOK_VERIFY_TOKEN_HEX_32

# --- JWT ---
JWT_SECRET=CHANGEME_JWT_SECRET_64_CHARS

# --- Database ---
DATABASE_URL=postgresql://whatsapp:CHANGEME_DB_PASSWORD@localhost:5432/whatsapp_service

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=whatsapp-service

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=whatsapp-service
PROMETHEUS_PORT=9097
