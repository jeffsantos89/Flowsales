# finance-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.
# Bootstrap automático: ./scripts/setup-env.sh na raiz do monorepo.

# --- App ---
NODE_ENV=development
PORT=3009
LOG_LEVEL=debug
SERVICE_NAME=finance-service

# --- Database ---
DATABASE_URL=postgresql://finance:CHANGEME_DB_PASSWORD@localhost:5435/finance_service

# --- Redis (idempotência e cache) ---
REDIS_URL=redis://localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finance-service
KAFKA_GROUP_ID=finance-service-consumer

# --- JWT (validação via JWKS do auth-service) ---
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
JWT_AUDIENCE=flowsale-services

# --- NFSe (Focus NFe) ---
NFSE_PROVIDER=focus_nfe
FOCUS_NFE_TOKEN=CHANGEME_GET_FROM_FOCUS_NFE_PANEL
FOCUS_NFE_WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET_HEX_32
FOCUS_NFE_BASE_URL=https://homologacao.focusnfe.com.br  # producao: https://api.focusnfe.com.br

# --- Empresa (dados fiscais para NFSe) ---
COMPANY_LEGAL_NAME="JA QUALITY ASSURANCE SOLUTIONS LTDA - ME"
COMPANY_TRADE_NAME="AGNES E SANTOS TECH SOLUTIONS"
COMPANY_CNPJ=55344803000155
COMPANY_CNPJ_FORMATTED="55.344.803/0001-55"
COMPANY_TAX_REGIME=simples_nacional
COMPANY_INSCRICAO_MUNICIPAL=CHANGEME_INSCRICAO_MUNICIPAL
COMPANY_DEFAULT_SERVICE_CODE=CHANGEME_CODIGO_SERVICO_MUNICIPAL
COMPANY_ADDRESS_STREET=CHANGEME
COMPANY_ADDRESS_NUMBER=CHANGEME
COMPANY_ADDRESS_CITY=CHANGEME
COMPANY_ADDRESS_STATE=SP
COMPANY_ADDRESS_ZIP=CHANGEME
COMPANY_EMAIL_FISCAL=CHANGEME@flowsale.app

# --- Dunning ---
DUNNING_CRON=0 */6 * * *
DUNNING_MAX_ATTEMPTS=4

# --- Invoice ---
INVOICE_NUMBER_PREFIX=FS
INVOICE_DUE_DAYS_DEFAULT=7

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=finance-service
PROMETHEUS_PORT=9094
