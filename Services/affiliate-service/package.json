{
    "name": "affiliate-service",
    "version": "1.0.0",
    "description": "Affiliate management service for Flowsale",
    "main": "dist/app.js",
    "scripts": {
        "start": "node dist/app.js",
        "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
        "build": "tsc",
        "test": "jest --coverage",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write .",
        "prepare": "husky install",
        "precommit": "lint-staged",
        "analyze": "webpack --profile --json > stats.json",
        "docker:build": "docker build -t affiliate-service:latest .",
        "docker:run": "docker run -p 4000:4000 affiliate-service:latest"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.11",
        "@nestjs/core": "^11.0.11",
        "@nestjs/platform-express": "^11.0.11",
        "@nestjs/typeorm": "^11.0.0",
        "@opentelemetry/api": "^1.9.0",
        "@redis/client": "^1.6.0",
        "@redis/graph": "^1.1.1",
        "@sentry/integrations": "^7.120.3",
        "@sentry/node": "^7.120.3",
        "@sentry/profiling-node": "^1.x.x",
        "@sentry/tracing": "^7.120.3",
        "@types/bcrypt": "^5.0.2",
        "@types/express-rate-limit": "^5.1.3",
        "@types/joi": "^17.2.2",
        "@types/rate-limit-redis": "^1.7.4",
        "axios": "^1.8.2",
        "bcrypt": "^5.1.1",
        "body-parser": "^1.19.0",
        "celebrate": "^15.0.3",
        "class-validator": "^0.14.1",
        "dotenv": "^10.0.0",
        "express": "^4.18.2",
        "express-rate-limit": "^7.5.0",
        "express-validator": "^7.2.1",
        "helmet": "^8.0.0",
        "ioredis": "^5.6.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "kafkajs": "^1.15.0",
        "morgan": "^1.10.0",
        "pg": "^8.7.1",
        "rate-limit-redis": "^4.2.0",
        "redis": "^4.2.0",
        "reflect-metadata": "^0.2.2",
        "rotating-file-stream": "^3.2.6",
        "rxjs": "^7.8.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^4.6.3",
        "typeorm": "^0.3.21",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0",
        "winston-logstash": "^1.2.1",
        "winston-logstash-transport": "^2.0.0",
        "zod": "^3.16.0"
    },
    "devDependencies": {
        "@types/chai": "^5.2.0",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/cypress": "^0.1.6",
        "@types/express": "^4.17.13",
        "@types/jest": "^27.5.2",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/morgan": "^1.9.9",
        "@types/node": "^17.0.45",
        "@types/redis": "^2.8.32",
        "@types/supertest": "^6.0.2",
        "@types/winston": "^2.4.4",
        "@typescript-eslint/eslint-plugin": "^5.14.0",
        "@typescript-eslint/parser": "^5.14.0",
        "cypress": "^14.2.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "husky": "^7.0.4",
        "jest": "^27.4.7",
        "lint-staged": "^12.3.7",
        "prettier": "^2.5.1",
        "supertest": "^7.0.0",
        "ts-node": "^10.7.0",
        "ts-node-dev": "^1.1.8",
        "typescript": "^4.6.3",
        "webpack": "^5.68.0",
        "webpack-cli": "^4.9.2"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "pre-push": "npm test"
        }
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "engines": {
        "node": ">=14.0.0",
        "npm": ">=6.0.0"
    }
}
