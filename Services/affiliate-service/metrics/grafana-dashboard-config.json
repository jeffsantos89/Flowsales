{
  "dashboard": {
    "id": null,
    "uid": "affiliate-service-metrics",
    "title": "Affiliate Service Metrics",
    "timezone": "browser",
    "schemaVersion": 26,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "type": "graph",
        "title": "Requests per Minute",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(http_requests_total[1m])",
            "legendFormat": "{{method}} {{handler}}",
            "interval": "",
            "refId": "A"
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "stack": false
      },
      {
        "type": "graph",
        "title": "CPU Usage",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total[1m])",
            "legendFormat": "{{container_name}}",
            "interval": "",
            "refId": "B"
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "stack": false
      },
      {
        "type": "graph",
        "title": "Memory Usage",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes) by (container_name)",
            "legendFormat": "{{container_name}}",
            "refId": "C"
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "stack": false
      },
      {
        "type": "graph",
        "title": "Error Rate",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(http_requests_total{status!~'2..'}[1m]) / rate(http_requests_total[1m])",
            "legendFormat": "Error Rate",
            "refId": "D"
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "stack": false
      },
      {
        "type": "singlestat",
        "title": "Active Affiliates",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "count(affiliate_service_active_affiliates)",
            "refId": "E"
          }
        ],
        "format": "none",
        "valueName": "current",
        "colorValue": true,
        "thresholds": "0,50,100",
        "colors": ["#F2495C", "#F2C96D", "#73BF69"]
      },
      {
        "type": "singlestat",
        "title": "Total Commissions",
        "gridPos": {
          "x": 6,
          "y": 16,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(affiliate_service_commissions_total)",
            "refId": "F"
          }
        ],
        "format": "currency",
        "valueName": "current",
        "colorValue": true,
        "thresholds": "0,1000,5000",
        "colors": ["#F2495C", "#F2C96D", "#73BF69"]
      }
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
