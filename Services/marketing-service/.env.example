# marketing-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.

# --- App ---
NODE_ENV=development
PORT=3005
LOG_LEVEL=info
SERVICE_NAME=marketing-service

# --- Database ---
DB_HOST=localhost
DB_USER=postgres
DB_PASS=CHANGEME_DB_PASSWORD
DB_NAME=flowsale_marketing
DB_PORT=5432

# --- JWT ---
JWT_SECRET=CHANGEME_JWT_SECRET_64_CHARS
JWT_EXPIRES_IN=1h

# --- Email (SMTP) ---
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=CHANGEME_EMAIL_USER
EMAIL_PASS=CHANGEME_EMAIL_PASS

# --- Redis (Bull queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD
