# voip-service — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.

# --- App ---
NODE_ENV=development
PORT=3009
LOG_LEVEL=info
SERVICE_NAME=voip-service

# --- Asterisk ARI ---
ARI_URL=http://asterisk:8088
ARI_USER=CHANGEME_ARI_USER
ARI_PASS=CHANGEME_ARI_PASSWORD_STRONG

# --- Auth básica do serviço ---
AUTH_USER=CHANGEME_ADMIN_USER
AUTH_PASS=CHANGEME_ADMIN_PASSWORD_STRONG

# --- SSL (opcional em dev) ---
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
