{
  "name": "frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "prepare": "husky install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.70.0",
    "@types/react-toastify": "^4.0.2",
    "axios": "^1.3.5",
    "jwt-decode": "^4.0.0",
    "next": "^15.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^5.0.0",
    "react-router-dom": "^6.14.2",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "eslint": "^8.31.0",
    "eslint-plugin-react": "^7.31.0",
    "husky": "^8.0.1",
    "lint-staged": "^15.5.0",
    "prettier": "^2.8.4",
    "react-scripts": "^5.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "plugin:react/recommended",
      "prettier"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "overrides": {
    "nth-check": "^2.0.1",
    "postcss": "^8.4.31",
    "micromatch": "^4.0.8",
    "svgo": "^2.0.0"
  }
}
