# Frontend — variáveis de ambiente
# NUNCA commitar valores reais. Use Vault/Secrets Manager em produção.
# Para dev local: copiar para .env.local (ignorado pelo git)

# --- API URLs ---
VITE_API_BASE_URL=http://localhost:3001
VITE_CRM_API_URL=http://localhost:3004
VITE_LEADS_API_URL=http://localhost:3003
VITE_AUTH_API_URL=http://localhost:3001
VITE_FINANCE_API_URL=http://localhost:3009
VITE_PAYMENT_API_URL=http://localhost:3006
VITE_INTEGRATIONS_API_URL=http://localhost:3011

# --- Feature flags ---
VITE_FEATURE_CHECKOUT_ENABLED=true
VITE_FEATURE_WHATSAPP_ENABLED=false
VITE_FEATURE_VOIP_ENABLED=false

# --- Observabilidade ---
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
